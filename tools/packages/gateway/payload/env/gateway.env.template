# gateway.env.template — concurrency-proxy-v2 配置模板（**密钥值绝不入包**）
# 落位：宿主 0600（/opt/aicad-prod/secrets/gateway.env；01 现役值面见 GATEWAY-MIGRATION §〇）
# 用法：部署窗按机填值；GW_API_KEY 值=密钥串，禁入 git/日志/镜像（SMOK_KEY 前科律）。
# 部署序（GW-INFRAS-AUDIT-20261014 A7）：本件先填值落位→gw-verify --offline 验绿
# →再落 unit（EnvironmentFile 无 `-` 容缺前缀=env 缺即启动快败，防裸默认值误指 8002）。
UPSTREAM=http://127.0.0.1:8899
PORT=8001
MAX_CONCURRENCY=16
# 准入等待（A3，对齐在役 zz-queue-timeout.conf drop-in 值 5；缺键→脚本默认 20=语义漂移）
QUEUE_TIMEOUT=5
# 长流参数（A1：CHUNK_IDLE_TIMEOUT 显式钉 600=rc3.8 O-2 实证值——注释写值却缺键的错配闭合；
#   01 在役主 unit 现值 180=rc3.8 已修病值，其改值+restart=重启窗承载，与 A10 同窗）
CHUNK_IDLE_TIMEOUT=600
# A2：思考链源头开关（rc3.6 注入；缺键→默认 0=按包部署即静默关思考链=行为反转）。
#   注入=双键：thinking（V4.1 族 overlay 读取键）+enable_thinking（其他模型族兼容键）。
#   2026-10-30 修复：此前只注入 enable_thinking，对 V4.1 族是 no-op（假键）——
#   外部站点 bug 报告坐实后改双键同注；显式下发任一键=用户管理不覆盖。
#   #45614 部署红线（sglang issue #45614 host 侧规避，2026-10-30）：主车道本键必须=1
#   且已入 gw-verify --offline lint 硬断言——裸请求（无 reasoning_effort/无 thinking
#   键）在引擎侧 SGLANG_DEFAULT_THINKING=1 时思维链漏进 content（prompt 侧回退读
#   env、解析侧不读的不对称）；双键注入使请求恒带显式 thinking 键 ⇒ 两侧同读真值。
#   引擎侧配套执法=tools/thinking_leak_guard.sh（env unset 律+本注入面+客户端锚）。
#   8001 在役形=1（inject.conf）；VL 车道=0（见 gateway-vl.env.template，呈裁 C3）。
INJECT_ENABLE_THINKING=1
# rc3.8.8 保守采样缺省档（DF-05/USR-1，缺省 0=关=行为零变化——PITFALLS P10-1
#   禁网关静默改写采样参数，故显式开关+客户端显式传参永远优先）：=1 时 POST
#   chat/completions 请求体缺省注入 temperature/top_p/frequency_penalty 三键
#   （值经下三键可调）；客户端已显式传任一键=完全不动 body（全或无，绝不混注）。
#   优先级：客户端显式 > 本缺省注入 > GW_SAMPLING_POLICY 策略改写。
#   开启态质量带需重定标（035-W0 任务书 DF-05：开/关态各 GSM8K 500 题双门）；
#   上线=需窗（compose 重建）+批文；判读期内禁切。Mac:8001 在役未设（=0）。
INJECT_CONSERVATIVE_SAMPLING=0
# 保守档三值（仅 INJECT_CONSERVATIVE_SAMPLING=1 时生效；DF-05 建议带中值）
CONSERVATIVE_TEMPERATURE=0.6
CONSERVATIVE_TOP_P=0.95
CONSERVATIVE_FREQUENCY_PENALTY=0.4
WRITE_TIMEOUT=60
TOTAL_STREAM_TIMEOUT=7200
DEDUP_ENABLE=1
# rc3.8.6 容量广播（②-a/A10，缺省关=行为零变化）：=1 时 GET /v1/models(/id) 响应侧
#   补客户端模型发现四键（context_length/context_window/max_input_tokens/limit.context），
#   取值=条目 max_model_len（引擎真值——红线：声明恒=引擎真值，禁调大声明消本地检测）。
#   客户端（harness/llm-pi-ai 族）读不到四键 ⇒ 落默认窗 262144 ⇒ 长会话误报整轮丢。
#   Mac:8001 在役=1（GW-PATCH-20261015 窗）；01 面吸收=后续部署窗。
ADVERTISE_MODEL_CAPACITY=0
# 容量值：0=取条目 max_model_len（引擎实值，缺省）；>0=固定覆盖位（应急面，勿设）
MODELS_CONTEXT_LEN=0
GW_API_KEY=<值位空——部署窗填入，绝不入包>
