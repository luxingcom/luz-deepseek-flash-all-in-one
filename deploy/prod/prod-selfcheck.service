[Unit]
Description=LuZ production pinned-profile self-check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liux***ya
Group=liux***ya
Environment=HOME=/home/liux***ya
WorkingDirectory=/home/liux***ya
ExecStart=/home/liux***ya/migrate-assets/prod/selfcheck-prod.sh --fast
Nice=10
TimeoutStartSec=120
# Read-only check: it never restarts or reconfigures the stack.
