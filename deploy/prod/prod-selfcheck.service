[Unit]
Description=LuZ production pinned-profile self-check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liuxiaoya
Group=liuxiaoya
Environment=HOME=/home/liuxiaoya
WorkingDirectory=/home/liuxiaoya
ExecStart=/home/liuxiaoya/migrate-assets/prod/selfcheck-prod.sh --fast
Nice=10
TimeoutStartSec=120
# Read-only check: it never restarts or reconfigures the stack.
