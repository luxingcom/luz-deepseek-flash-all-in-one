# LuZ 0.3.2 production boot profile — single source of truth.
# Sourced by boot-prod.sh and selfcheck-prod.sh.  Never pass these values ad hoc;
# change this file, review the diff, then re-run the boot.
PROD_CTN_PREFIX=r3prod
PROD_API_PORT=8899
PROD_SPEC=1
PROD_ARM_ENV_FILE=<assets-root>/dsv41/env/CBX1A-CERTM-spec1.env
PROD_ARM_ENV_MD5=4370aab9c501cd0cfd3d89bb0137c433
PROD_ARM_ENV_KEYS=61
PROD_SPEC_EXTRA_ARGS="--prefill-decode-interval 16 --max-queued-requests 32 --min-free-slots-delay 1 --enable-decoder-swa-bounded-replay --reasoning-parser deepseek-v41 --swa-prefix-tails 256"
PROD_OVERLAY_DIR=<assets-root>/v4vl/sglang-overlay.o12c1-prod
PROD_OVERLAY_COUNT=29
PROD_OVERLAY_MANIFEST=<assets-root>/prod/overlay-md5.txt
PROD_RECIPE_MANIFEST=<assets-root>/prod/recipe-md5.txt
PROD_SERVING_CHAT_MD5=9b60a46312363add8c119a950ddc6c2c
PROD_RECIPE_MD5=da98467d3fd7d5019ea025b3d5273a20
PROD_BOOT_SCRIPT=<assets-root>/bin/r3-boot-arm.sh
PROD_BOOT_SCRIPT_MD5=50700486996405514a3f2f07b11feb48
PROD_WRAPPER=<deploy-workspace>/tools/boot-with-slotlock.sh
PROD_IMAGE=<registry-host>:<registry-port>/dsv41-sglang-optimized:0.3.4-x6bake-20261026
PROD_IMAGE_DIGEST=sha256:80e4c95712f3369ae4c087e1a879a3b63343f0469e5eb5a02aa7513b4968f7d0
PROD_RX_RING=4096
PROD_PORTS="<nic-names>"
# Rolled back 2026-10-22: production runs the historical 6.17 kernel with the
# matching 580.173.02 NVIDIA userspace/modules.  7.0.0 stays installed in GRUB
# but is not an accepted production boot target.  The driver allowlist is
# checked both via nvidia-smi (userspace) and modinfo (loaded kernel module);
# a mismatch means an NVRM API mismatch and must fail closed.
PROD_KERNEL_ALLOW="6.17.0-1031-nvidia"
PROD_NVIDIA_DRIVER_ALLOW="580.173.02"
PROD_HOSTS="<prod-host-01> <prod-host-02> <prod-host-03> <prod-host-04>"
PROD_ADAPTER_FILES=98
PROD_ADAPTER_FINGERPRINT=d52b0e3d  # 2026-10-28 锁档 8-hex 集签名历史时点值（另律不混用）；canon98 前态面 manifest-md5=5c2c88eb（fingerprint.py 口径），交付验收以 deploy/adapter/0.3.4-MANIFEST.md5 为准（2026-10-31 代际注记）
PROD_NIC_FW_ALLOW="28.50.1002"
# Lossless shared buffer (mlnx_qos buffer 1) before the 28.50 firmware update
# was 523296 B; the update defaulted it to 458496 B.  Production pins the
# pre-update margin back (user decision 2026-10-22): the PFC prio3/prio5 class
# keeps its burst absorption through the switch, not just the direct-link case.
PROD_LOSSLESS_BUFFER=523296
# Warm gate: five consecutive 64k PR reads; the first is cold and discarded,
# median of reads 2..5.  A single cold read was 5284 tok/s while the same
# boot's warm median was ~5900 tok/s.
PROD_WARM_GATE_TOK_S=5600
PROD_WARM_GATE_RUNS=5
PROD_WARM_GATE_SIZE=65536
PROD_LOG_DIR=$HOME/r3-prod-logs
PROD_RECIPE_PROBE=<assets-root>/prod/recipe_probe.py
PROD_BENCH=<deploy-workspace>/tools/bench/sd_bench.py
