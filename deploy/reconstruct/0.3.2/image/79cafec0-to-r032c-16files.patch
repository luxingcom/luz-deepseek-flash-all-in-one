+        q.stride(1),
+        weights.stride(0),
+        H=heads,
+        HALF_D=INDEX_HEAD_DIM // 2,
+        RATIO=ratio,
+        HAS_MASK=candidate_mask is not None,
+        BLOCK_L=64,
+        num_warps=4,
+    )
+    return out[:, :max_len]
