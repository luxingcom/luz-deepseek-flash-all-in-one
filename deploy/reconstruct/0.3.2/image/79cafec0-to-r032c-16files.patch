+        weights,
+        req,
+        req_table,
+        lens,
+        table,
+        candidate_mask,
+        out,
+        max_len,
+        page_size,
+        table.stride(0),
+        req_table.stride(0),
+        candidate_mask.stride(0) if candidate_mask is not None else 0,
