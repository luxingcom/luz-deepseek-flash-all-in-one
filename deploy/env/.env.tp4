# .env.tp4 — OUR fleet adaptation (<recipe-id> recipe → 4× DGX Spark, <cluster-subnet>.x)
# Base: .env.tp4.ring.example (the friend fleet's production config).
# Deviations, each tied to our cluster's measured reality:
#  HEAD_IP/WORKER_IPS  our mgmt subnet, ring order rank1=02 rank2=04 rank3=03
#            (same non-sequential pattern as the recipe fleet and as
#            our own v043 production start_tp4_cluster.sh)
#  NCCL_IB_GID_INDEX_FORCE=3  OUR kernel (6.17.0-1029) fleet-measured GID
#            (docker inspect 2026-08-13 production). The recipe's -1
#            is a kernel-1031 GID-reorder workaround we don't need.
#  WORKER_MODEL_DIR_1  02 holds full local weights; 03/04 read 46 shards over
#  WORKER_EXTRA_MOUNTS_2/3  the dsv41-net NFS view with the two Engram shards
#            bind-mounted from LOCAL files — the row-store then
#            never reads Engram over the network (hard rule).
#  CONTEXT_LENGTH=600000 / MAX_TOTAL_TOKENS=9600000 (S5 2026-09-17: 256K->600K)
#            per the recipe's own plan §Decision 5; ramp after soak.
#            ★2026-09-16 现状：pin 已按 R2 变更 #15 升到 9,600,000
#            （=NSEQ16×600K 联立，见下方 MAX_TOTAL_TOKENS 行与 guards.conf
#            的 sglang-pin PRECOND）；本行保留为初始值的历史说明。
#  PEER_HCA unset    first boot lets NCCL auto-route (SUBNET_AWARE_ROUTING=1);
#            per-peer HCA pinning is a follow-up A/B.
#  PORT 8899 loopback  our 8001 proxy / 8012 test slot untouched.
#  no dspark SPS/STS tables — verify-all schedule until we profile our own.
#  NCCL_DEBUG 关闭    调试期设过 INFO + 调试文件写 /nccl-debug；2026-09-16 交付前
#            清查关闭（详见下方注释），由 start.sh 默认 WARN 接管。
#  SKIP_VERIFY 删除    在 SKIP_PREPARE=1 下结构性不可达（"设置了但不在路径上"）。
#  容器内存上限 24g    实测这道闸压住的是**可回收页缓存**，不是 anon：四机 memory.peak
#            顶在上限（head 超 1 页、三 worker 精确相等）、memory.events.max
#            2.7-3.0 万次，而 oom_kill **四机全 0**；pgsteal 累计 721GiB（文件页主导），
#            anon 峰值 11.09GiB 距上限还有 13GiB。⇒ 它的职能是给加载期的页缓存上闸：
#            宿主 MemFree 仅 1.16GiB，而 GPU 的 ~99GiB 统一内存正是从同一个池子里拿。
#            抬高上限（曾试 32g）等于让页缓存去抢 GPU 的口粮。详见 start.sh 注释。
#  DSV41_CACHE_GIB=1   已批准值（不是 start.sh 里那个 4 的旧默认值——已一并改成 1）。
#            1GiB 下 Engram 命中率已 99.1%；4GiB 实测会把 900K 单 prompt 打成失败
#            （地板 3.53→1.50GB）。
#  SGLANG_CODE_MOUNTS=0（默认，生产）代码全部来自镜像内 /sgl-workspace/sglang 与
#            /opt/dsv41/adapter、/opt/b12x；设 1 才逐文件 bind-mount 宿主
#            overlay（开发用，见 start.sh 顶部注释）。

# ─── cluster ─────────────────────────────────────────────────────────────────
HEAD_IP=<head-ip>
WORKER_IPS="<worker-ips>"
WORKER_HOSTS="<prod-host-02> <prod-host-04> <prod-host-03>"
WORKER_USER=<worker-user>
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# ─── fabric ──────────────────────────────────────────────────────────────────
FABRIC_IFACE=<fabric-iface>
GLOO_SOCKET_IFNAME=<socket-iface>
NCCL_SOCKET_IFNAME=<socket-iface>
IB_HCA=<hca-names>
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
# 调试期开关，2026-09-16 关闭（交付前清查）：曾设 NCCL_DEBUG=INFO + SUBSYS=INIT,ENV，
# 配套 EXTRA_DOCKER_ENV 里的 NCCL_DEBUG_FILE 写 /nccl-debug（RW 挂进四机生产容器，
# 累计 216KB 并随每次容器启动增长）。关掉后由 start.sh 默认值接管
# （NCCL_DEBUG=WARN / NCCL_DEBUG_SUBSYS=INIT），与 vLLM 生产栈一致。
# NCCL_DEBUG=INFO
# NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly
NCCL_BUFFSIZE=8388608
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_GID_INDEX_FORCE=3

# per-rank PEER_HCA (recipe production values, rank-translated — corroborated by
# our boot3 NCCL log: rank0 receive via NET/IB/0+IB/2 = "3=<hca-names>")
# ⚠2026-09-19 审计勘误：per-rank PEER_HCA 在 ring-only 2.30.7 库内硬编码映射替代下为死信
#  （库二进制 strings 零命中 + INFO 日志无回显；映射真身=库内 ADR-015 RING-ONLY v4 补丁）。
#  接线正确时无害。此段保留仅为环境记录，勿据此排障。
PEER_HCA_RANK0="1=<hca-names>;3=<hca-names>"
PEER_HCA_RANK1="0=<hca-names>;2=<hca-names>"
PEER_HCA_RANK2="1=<hca-names>;3=<hca-names>"
PEER_HCA_RANK3="0=<hca-names>;2=<hca-names>"

# static ring NCCL + general env, appended last so it wins duplicates
# 2026-09-16 步骤 4（单变量）：拧紧 dense indexer 的 logits row-chunk 预算。
#  1<<31(2GiB, 历史值) → 1<<29(512MiB)。默认(不设)=1<<31 ⇒ 本行删掉即回退。
#  为什么：该层 seq_len//ratio(ratio=1 层有 20 层) 就是 lc，是**整段前缀**（245.7K prompt
#  ⇒ lc=245760）。logits 张量 [chunk_rows, lc] fp32，其**峰值恒等于预算本身**
#  （rows_per_chunk = budget//(lc_aligned*4)）⇒ 2GiB→512MiB 直接把瞬态峰砍到 1/4。
#  社区对照：sglang #36941（2×GB10）强制 512-row logits 分块把 >300s 超时变成 135s PASS。
#  只影响长前缀 prefill（lc 大时才会分块）；decode/short-prefill 的 lc 小 ⇒ 单趟不变。
EXTRA_DOCKER_ENV="NCCL_ALGO=RING NCCL_IB_TIMEOUT=1000 NCCL_IB_RETRY_CNT=7 NCCL_IB_TOS=46 NCCL_IGNORE_CPU_AFFINITY=1 NCCL_MIN_NCHANNELS=4 NCCL_SET_THREAD_NAME=1 NCCL_NET_PLUGIN=none NCCL_TUNER_THRESHOLD=40960 NCCL_CUMEM_HOST_ENABLE=0 TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_DISABLE_VERSION_CHECK=1 PYTHONFAULTHANDLER=1 HF_HUB_OFFLINE=1 DSV41_SHARED_PAD_K=1 EP_SUPPRESS_NCCL_CHECK=1 SGLANG_RAGGED_VERIFY_MODE=static MALLOC_ARENA_MAX=2 DSV41_MOE_B12X=0 DSV41_MOE_B12X_CAPS=128,256,512,1024,2304,4096 DSV41_MOE_B12X_QUANT=a8 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_SKIP_NONFINAL_DECODER=1 SGLANG_QW3_DSPARK_LAUNCH_PARAMS=1 SGLANG_DSV4_KV_LAYOUT=v41 DSV41_DENSE_INDEXER_LOGITS_BUDGET_BYTES=536870912 DSV41_PREFILL_SHARE_TOKENS=4096 DSV41_PREFILL_EMPTY_CACHE_TOKENS=0 SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0 DSV41_IDX_PROTOCOL=1 DSV41_IDLE_RELEASE=1 DSV41_SCHED_SNAPSHOT=1 SGLANG_DSV4_PAGETABLE_PAGES_GRID=1 DSV41_VERIFY_PRUNE=0 DSV41_VERIFY_PRUNE_LOG=1 DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_FOLDED_FENCE=1 DSV41_LOOP_ABORT=0 DSV41_L2_PREFETCH=1 DSV41_EAGER_GLUE=all DSV41_VERIFY_CAP=conf:0.1 DSV41_ROUTER_LIVE=1 DSV41_SPEC_SYNC_FREE=all DSV41_ROCE_RING=1 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=2097152 DSV41_ROCE_GATHER=524288 B12X_ROCE_HCA=<hca-names> B12X_ROCE_PEER_HCA_MAPS=1=1/3,2=0/3,3=0/2;0=1/3,2=0/2,3=0/3;0=1/2,1=0/2,3=1/3;0=0/2,1=1/2,2=1/3 B12X_ROCE_TWO_WAVE_THRESHOLD_BYTES=0 DSV41_SPARK_PREFILL_TP_SPLIT=1 DSV41_LAUNCHER=tp4 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_HC_FUSED=1"
# 2026-09-16 W8: 删两个「设置了但不在路径上」的 flag（项 3，源码级已证死）：
#  SGLANG_OPT_DSV4_NONPAGED_INDEXER_MIN_QUERY_TOKENS=4096
#   _get_nonpaged_indexer_plan 只被 C4Indexer 调（dsv4_indexer.py:825），
#   而 C4Indexer 只在 compress_ratio==4 时构造；本模型 compress_ratios={0:5,2:18,1:20}
#   ⇒ 无 ratio-4 层 ⇒ 任何 chunk 尺寸下都不生效。
#  --deepseek-v4-prefill-reuse uniform-w4
#   maybe_apply_reuse 的唯一调用点在同一死分支内（dsv4_indexer.py:906）。
#  两者都属 #38979（uniform-w4 是 leader-row 广播的预设名）被挂错分支的产物；
#  真正的 dense 低比打分路径是 _low_ratio_index_topk_dense（当前全量打分、零复用），
#  要拿增益须改挂到那里并做 A/B —— 那是独立立项，不是「保留两个死 flag」。

# ─── model / image ───────────────────────────────────────────────────────────
MODEL_DIR=<models-dir>/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
# 生产镜像：SGLANG_CODE_MOUNTS=0 时代码/资产**只来自它**（不再是 dsv41-4x-spark:local——
# 那份里没有 overlay，也没有烘入的 NCCL ring-only/b12x/shim，换上就会静默丢这些东西）。
# 逐机核对：bash <交付目录>/verify_image.sh $IMAGE（构建时落盘的 checker-*.tsv 判据）
IMAGE=dsv41-sglang-optimized:<legacy-image-tag>2
EXPECTED_SHARDS=48

# ─── weights: per-worker sources ─────────────────────────────────────────────
WEIGHTS_MODE=local
# fallback (worker without a per-rank override):
WORKER_MODEL_DIR=<models-dir>/dsv41-net
# rank1 = <prod-host-02>: full local checkpoint
WORKER_MODEL_DIR_1=<models-dir>/DeepSeek-V4.1-Flash
# rank2 = <prod-host-04>, rank3 = <prod-host-03>: NFS view of the 46 remote shards +
# the two Engram shards pinned to the LOCAL files (never over the network)
WORKER_MODEL_DIR_2=<models-dir>/dsv41-net
WORKER_MODEL_DIR_3=<models-dir>/dsv41-net
ENG_SH47=<models-dir>/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors
ENG_SH48=<models-dir>/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors
WORKER_EXTRA_MOUNTS_2="-v <models-dir>/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:ro -v <models-dir>/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:ro"
WORKER_EXTRA_MOUNTS_3="-v <models-dir>/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:ro -v <models-dir>/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:ro"
NFS_SHARE=0
WORKER_DIR=<user-home>/dsv41-4x-spark

# ─── parallelism ─────────────────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=1
DIST_PORT=20000

# ─── serving ─────────────────────────────────────────────────────────────────
PORT=8899
HOST=127.0.0.1
API_KEY=***MASKED-034LOCK***
SERVED_MODEL_NAME=deepseek-v4.1-flash

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=1
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# W8 单变量（项 2b①）：V4 repack 桥的 scratch 预算。
#  512 ⇒ max_rows 917,504 ⇒ chunk 4096×topk 512 需切 3 片（现状默认）
#  4096 ⇒ 1 片（行数不变，只少 2 次 attention 重入 + 2 次 torch.cat）
# W8 结论（项 2b①）：SGLANG_DSV4_FP4_BRIDGE_SCRATCH_MB 512→4096 真能把切片
# 4313→0（实测 extra_slices=0），但端到端无可复现收益（123.4/122.1 vs
# 130.9/117.4 s，逐 seed 排序自相矛盾），却要多占最多 ~1.2 GB 显存 ⇒ **不采纳**，
# 保持默认 512。该旋钮若要用，必须放进 EXTRA_DOCKER_ENV（独立行不进容器）。
# conservative first boot on the ring: 256K context / 2M KV pool
CONTEXT_LENGTH=600000
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_RUNNING_REQUESTS=16
CHUNKED_PREFILL_SIZE=4096
# 2026-09-16 变更 #15（用户指示）：NSEQ 12→16 与 pin 联立为 16×600k = 9,600,000。
# ⚠口径提醒（S5 2026-09-17）：本文件 CONTEXT_LENGTH=600000，16 路 pin = 16×600,000 = 9,600,000 = MAX_TOTAL_TOKENS（O1 裁定：满并发池余量归零，radix 缓存工作集 0，retraction_policy=length 兑底）
# 16×262,144 = 4.19M token；9.6M 的其余部分是 radix 前缀缓存工作集，
# 「16 路各 600K 同时在线」在当前 context 下不可达（要达须另开 context 提升变更）。
# ⚠地板风险：池价 0.850 GiB/M token ⇒ 8M→9.6M 从 head 地板拿走 ~1.36 GiB；
# 8M 实测最坏 eff 5.57 ⇒ 9.6M 预期 ~4.2 GiB。改值必须重测地板（本窗执行）。
MAX_TOTAL_TOKENS=9600000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards (pack after the first stable boot) ─────────────────
ENGRAM_DIR=<user-home>/dsv41-engram
DSV41_PACKED_DIR=/engram
# 权重是预先就位的（02 本机全量、03/04 走 dsv41-net NFS + 两个 Engram 分片本地绑定），
# 不走 HF 下载：HF_HUB_OFFLINE=1 之下 prepare() 的下载分支结构性不可达。
# SKIP_PREPARE=1 只做一件事：断言 <model>/config.json 在位（boot.py:50-53）。
# 2026-09-16 删除 SKIP_VERIFY=1：它只出现在下载分支内部（boot.py:69），
# 在 SKIP_PREPARE=1 下**永远走不到** —— 属"设置了但不在路径上"，留着反而误导
# （若有人翻回 SKIP_PREPARE=0，它会静默跳过校验和比对）。权重完整性由离线
# SHA256SUMS 一次性验证，见 V41-SGLANG-SESSION-DOSSIER §8。
SKIP_PREPARE=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ─────────────────────────────────────────────────
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --enable-metrics --min-free-slots-delay 1 --prefill-decode-interval 4 --max-queued-requests 32 --enable-encoder-swa-bounded-replay"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
# DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192 # 2026-09-21 白盒清理：死配置——独立行不进容器（start.sh 只透传白名单+EXTRA_DOCKER_ENV），真值=EXTRA_DOCKER_ENV 里的 =0（钩子卸载）

# ─── TP4 runtime ─────────────────────────────────────────────────────────────
DSV41_TP_PAD=0
CTN_MEMORY=32g # C28: 武装探针 flush 峰 21.7G+ 需 32g 帽；宿主 oom-gate 1.5G 地板照旧兜底（2026-09-28 用户批准放宽）
